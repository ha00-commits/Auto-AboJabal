<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أوتو أبوجبل"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="صنع بواسطة: أبوجبل ابن الكوت\n@P71GP"
            android:textColor="#00FFCC"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSelectKeyboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="1. اختيار كيبورد أوتو أبوجبل"
            android:backgroundTint="#00FFCC"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الكلمات (كل كلمة بسطر):"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/wordsInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#1A1A1A"
            android:textColor="#FFFFFF"
            android:gravity="top|start"
            android:hint="اكتب كلماتك هنا..."
            android:textColorHint="#888888"
            android:padding="10dp"
            android:layout_marginBottom="15dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp">
            
            <EditText
                android:id="@+id/speedInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:text="50"
                android:hint="السرعة (ms)"
                android:textColorHint="#888888"
                android:padding="10dp"
                android:layout_marginEnd="10dp" />

            <Switch
                android:id="@+id/fawarizSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفوارز"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Switch
            android:id="@+id/tatirSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="التسطير (سطر واحد بدون انتر)"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="حفظ الإعدادات"
            android:backgroundTint="#00FFCC"
            android:textColor="#000000"
            android:textStyle="bold" />
            
    </LinearLayout>
</ScrollView>
